
@model IEnumerable<Asp.netWebDatVe.Models.ThanhToan>

@{
    ViewData["Title"] = "Danh sách thanh toán";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>Danh sách thanh toán</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Mã TT</th>
            <th>Mã Phiếu</th>
            <th>Phương Thức</th>
            <th>Số Tiền</th>
            <th>Ngày Thanh Toán</th>
            <th>Trạng Thái</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaThanhToan</td>
                <td>@item.MaPhieu</td>
                <td>@item.PhuongThuc</td>
                <td>@item.SoTien.ToString("N0")</td>
                <td>@item.NgayThanhToan.ToString("dd/MM/yyyy")</td>
                <td>@item.TrangThai</td>
                <td>
       
                    <a asp-action="Delete" asp-route-id="@item.MaThanhToan" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
