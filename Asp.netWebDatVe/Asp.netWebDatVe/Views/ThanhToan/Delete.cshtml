@model Asp.netWebDatVe.Models.ThanhToan

@{
    ViewData["Title"] = "Xóa Thanh Toán";

    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h1>Xóa Thanh Toán</h1>

<h3>Bạn có chắc muốn xóa thanh toán này?</h3>
<div>
    <h4>Thông tin thanh toán</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MaThanhToan)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MaThanhToan)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MaPhieu)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MaPhieu)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PhuongThuc)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PhuongThuc)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.SoTien)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SoTien)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NgayThanhToan)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NgayThanhToan)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MaGiaoDich)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MaGiaoDich)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TrangThai)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TrangThai)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="MaThanhToan" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index">Quay lại danh sách</a>
    </form>
</div>
