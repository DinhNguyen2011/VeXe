@model Asp.netWebDatVe.Models.ThanhToan

@{
    ViewData["Title"] = "Thêm thanh toán";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>Thêm mới thanh toán</h2>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="MaPhieu"></label>
        <input asp-for="MaPhieu" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="PhuongThuc"></label>
        <input asp-for="PhuongThuc" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="SoTien"></label>
        <input asp-for="SoTien" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="NgayThanhToan"></label>
        <input asp-for="NgayThanhToan" type="date" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="TrangThai"></label>
        <input asp-for="TrangThai" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="MaGiaoDich"></label>
        <input asp-for="MaGiaoDich" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
