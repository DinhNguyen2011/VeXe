@model IEnumerable<Asp.netWebDatVe.Models.PhieuDatVe>

@{
    ViewData["Title"] = "Danh sách phiếu đặt vé";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<style>
    .phieudatve-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .phieudatve-title {
        text-align: center;
        margin-bottom: 20px;
    }

    .phieudatve-alert {
        width: 80%;
        margin: 10px auto;
    }

    .phieudatve-filter {
        margin-bottom: 20px;
        max-width: 300px;
    }

    .table-responsive {
        overflow-x: auto;
        width: 100%;
    }

    .table {
        width: 100%;
        font-size: 14px;
        border-collapse: collapse;
    }

        .table th, .table td {
            padding: 8px;
            text-align: center;
            border: 1px solid #ddd;
            vertical-align: middle;
        }

        .table th {
           
            color: 343a40;
        }

    .text-truncate {
        max-width: 150px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .col-thao-tac {
        width: 180px;
    }

    .action-buttons {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .btn-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        padding: 0;
        font-size: 16px;
    }

    .btn-reset {
        background-color: #6c757d;
        color: white;
        border: none;
        padding: 0;
        width: 32px;
        height: 32px;
    }
</style>

<div class="phieudatve-container">
    <h2 class="phieudatve-title">🎟️ Danh sách phiếu đặt vé</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success phieudatve-alert">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger phieudatve-alert">@TempData["Error"]</div>
    }

    <div class="phieudatve-filter">
        <form asp-action="Index" method="get">
            <label for="trangThai">Lọc theo trạng thái</label>
            <select name="trangThai" id="trangThai" class="form-control" onchange="this.form.submit()">
                <option value="">Tất cả</option>
                @foreach (var item in ViewBag.TrangThaiList)
                {
                    <option value="@item.Value" selected="@(item.Selected ? "selected" : null)">@item.Text</option>
                }
            </select>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Mã phiếu</th>
                    <th>Email</th>
                    @* <th>Ngày đặt</th> *@
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th>VNP Transaction ID</th>
                    <th>Momo Transaction ID</th>
                    <th>Khuyến mãi</th>
                    <th class="col-thao-tac">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MaPhieu</td>
                        <td class="text-truncate">@item.Email</td>
                        @* <td>@item.NgayDat?.ToString("dd/MM/yyyy HH:mm")</td> *@
                        <td>@item.TongTien?.ToString("N0") VNĐ</td>
                        <td>@item.TrangThai</td>
                        <td class="text-truncate">@item.VnpTransactionId</td>
                        <td class="text-truncate">@(item.MoMoTransactionId ?? "Không có")</td>
                        <td>@(item.MaKhuyenMaiNavigation?.TenKhuyenMai ?? "Không có")</td>
                        <td>
                            <div class="action-buttons">
                                <a asp-action="Edit" asp-route-id="@item.MaPhieu" class="btn btn-warning btn-sm btn-icon" title="Sửa phiếu">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.MaPhieu" class="btn btn-danger btn-sm btn-icon" title="Xóa phiếu"
                                   onclick="return confirm('Bạn có chắc chắn muốn xóa phiếu này không?');">
                                    <i class="bi bi-trash3-fill"></i>
                                </a>

                                @if (item.TrangThai == "Hủy")
                                {
                                    <form asp-action="ResetSeatsByPhieuDatVe" method="post" style="display:inline;" onsubmit="return confirm('Đặt lại trạng thái ghế cho phiếu @item.MaPhieu?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="maPhieu" value="@item.MaPhieu" />
                                        <button type="submit" class="btn-reset btn-icon" title="Đặt lại ghế">
                                            <i class="bi bi-arrow-clockwise"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
