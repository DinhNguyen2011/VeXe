@model Asp.netWebDatVe.Models.PhieuDatVe

@{
    ViewData["Title"] = "Sửa phiếu đặt vé";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<link rel="stylesheet" href="~/css/PhieuDatVe.css" />

<div class="phieudatve-container">
    <h2 class="phieudatve-title">Sửa phiếu đặt vé</h2>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MaPhieu" />

        <div class="form-group phieudatve-form-group">
            <label asp-for="Email" class="phieudatve-label"></label>
            <input asp-for="Email" class="form-control phieudatve-input" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group phieudatve-form-group">
            <label asp-for="NgayDat" class="phieudatve-label"></label>
            <input asp-for="NgayDat" class="form-control phieudatve-input" type="datetime-local" />
            <span asp-validation-for="NgayDat" class="text-danger"></span>
        </div>

        <div class="form-group phieudatve-form-group">
            <label asp-for="TongTien" class="phieudatve-label"></label>
            <input asp-for="TongTien" class="form-control phieudatve-input" type="number" step="0.01" />
            <span asp-validation-for="TongTien" class="text-danger"></span>
        </div>

        <div class="form-group phieudatve-form-group">
            <label asp-for="TrangThai" class="phieudatve-label"></label>
            <select asp-for="TrangThai" class="form-control phieudatve-select" asp-items="ViewBag.TrangThai"></select>
            <span asp-validation-for="TrangThai" class="text-danger"></span>
        </div>

        <div class="form-group phieudatve-form-group">
            <label asp-for="VnpTransactionId" class="phieudatve-label"></label>
            <input asp-for="VnpTransactionId" class="form-control phieudatve-input" />
            <span asp-validation-for="VnpTransactionId" class="text-danger"></span>
        </div>

        <div class="form-group phieudatve-form-group">
            <label asp-for="MaKhuyenMai" class="phieudatve-label">Khuyến mãi</label>
            <select asp-for="MaKhuyenMai" class="form-control phieudatve-select" asp-items="ViewBag.MaKhuyenMai">
                <option value="">Không áp dụng</option>
            </select>
            <span asp-validation-for="MaKhuyenMai" class="text-danger"></span>
        </div>

        <div class="form-group phieudatve-form-group">
            <button type="submit" class="btn btn-primary phieudatve-btn">Lưu</button>
            <a asp-action="Index" class="btn btn-secondary phieudatve-btn">Quay lại</a>
        </div>
    </form>
</div>

