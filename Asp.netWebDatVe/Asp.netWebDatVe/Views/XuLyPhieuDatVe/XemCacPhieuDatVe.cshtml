@model IEnumerable<Asp.netWebDatVe.Models.PhieuDatVe>

@{
    ViewData["Title"] = "Danh sách phiếu đặt vé";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/DanhSachPDTProF.css">

<div class="phieudatve-list-container">
    <h2 class="phieudatve-title">Danh sách phiếu đặt vé</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <p class="phieudatve-no-ticket">Bạn chưa có phiếu đặt vé nào.</p>
    }
    else
    {
        <table class="table phieudatve-table">
            <thead>
                <tr>
                    <th>Mã phiếu</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
              
                    var earliestDeparture = item.VeXes
                    .Select(v => v.MaChuyenNavigation?.ThoiDiemKhoiHanh)
                    .Where(d => d.HasValue)
                    .Min();

                    // Check if current time is equal to departure time
                    bool canCancel = earliestDeparture.HasValue && DateTime.Now < earliestDeparture.Value;

                    <tr>
                        <td>@item.MaPhieu</td>
                        <td>@item.NgayDat?.ToString("dd/MM/yyyy")</td>
                        <td>@item.TongTien?.ToString("N0") VNĐ</td>
                        <td>@item.TrangThai</td>
                        <td>
                            <a class="btn btn-info btn-sm btn-action" asp-controller="XuLyPhieuDatVe" asp-action="Details" asp-route-id="@item.MaPhieu">Xem</a>

                            @if (item.TrangThai == "Đã thanh toán" && canCancel)
                            {
                                <form asp-action="HuyPhieuDatVe" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn hủy phiếu này không?');">
                                    <input type="hidden" name="maPhieu" value="@item.MaPhieu" />
                                    <button type="submit" class="btn btn-danger btn-sm">Hủy vé</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>