@model Asp.netWebDatVe.Models.LienHe

@{
    ViewData["Title"] = "Liên hệ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



@* ✅ Hướng dẫn sửa đúng iframe Google Maps:
Vào địa chỉ bản đồ  muốn (ví dụ Khánh An hoặc địa điểm cụ thể).

Nhấn Chia sẻ (Share) → Chọn Nhúng bản đồ (Embed a map).

Copy iframe code được cung cấp.

 *@

<link href="~/css/LienHeVoiChungToi.css" rel="stylesheet" />

<section class="ka-contact-section py-5" style="margin-bottom:30px; border-radius:10px;">
    <div class="container">
        <h2 class="mb-4" style="color:#00ff34 !important">Liên hệ với Khánh An</h2>
        <div class="row">
            <div class="col-md-6">
                <h5 class="ka-info-title text-white" style="color:#00ff34 !important">Thông tin liên hệ</h5>
                <p class="text-white">Chúng tôi luôn sẵn sàng hỗ trợ bạn với dịch vụ xe chất lượng cao. Hãy liên hệ ngay để được tư vấn!</p>
                <div class="mb-3">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3918.9481317080736!2d106.67453061488324!3d10.817042061338934!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x317529292424ec6f%3A0x5c9514d3aa8ec19e!2zQsOhbmggWHXDom4gUGjGsMahbmcgVnVvIE5nw6JuIFBo4bqhbmcgVHLDrA!5e0!3m2!1svi!2s!4v1719228200101!5m2!1svi!2s"
                            width="100%" height="250" style="border:0;" allowfullscreen="" loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>

                <p><i class="fas fa-map-marker-alt"></i> <strong>Địa chỉ:</strong> 180 Cao Lỗ, Phường 4, Quận 8, Hồ Chí Minh, Việt Nam</p>
                <p><i class="fas fa-phone"></i> <strong>Điện thoại:</strong> 028 1234 5678</p>
                <p><i class="fas fa-envelope"></i> <strong>Email:</strong> lienhe@khanhanbus.vn</p>
                <p><i class="fas fa-globe"></i> <strong>Website:</strong> <a href="http://www.khanhanbus.vn" target="_blank" class="text-dark">www.khanhanbus.vn</a></p>
            </div>
            <div class="col-md-6">
                <h5 class="ka-info-title" style="color:#00ff34 !important">Gửi tin nhắn cho chúng tôi</h5>

                @* Hiển thị thông báo khi gửi thành công hoặc lỗi *@
                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-success">@ViewBag.Message</div>
                }
                @if (!string.IsNullOrEmpty(TempData["Error"] as string))
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                  <form asp-action="Index" asp-controller="LienHeVoiChungToi" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="HoVaTen" class="form-label ka-label"></label>
                        <input asp-for="HoVaTen" class="form-control ka-input" />
                        <span asp-validation-for="HoVaTen" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label ka-label"></label>
                        <input asp-for="Email" class="form-control ka-input" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Sdt" class="form-label ka-label"></label>
                        <input asp-for="Sdt" class="form-control ka-input" placeholder="Nhập số điện thoại (tùy chọn)" />
                        <span asp-validation-for="Sdt" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NoiDung" class="form-label ka-label"></label>
                        <textarea asp-for="NoiDung" class="form-control ka-input" rows="4"></textarea>
                        <span asp-validation-for="NoiDung" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn ka-submit-btn">Gửi</button>
                </form>
            </div>
        </div>
    </div>
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate-unobtrusive/3.2.11/jquery.validate.unobtrusive.min.js"></script>
