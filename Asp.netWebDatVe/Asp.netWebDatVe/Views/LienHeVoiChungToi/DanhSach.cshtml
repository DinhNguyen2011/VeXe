@model List<Asp.netWebDatVe.Models.LienHe>

@{
    ViewData["Title"] = "Danh sách liên hệ";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Link Bootstrap Icons (nếu chưa có trong layout) -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<h2 class="mb-4 text-center">Danh sách liên hệ khách hàng</h2>

<div class="container">
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle text-center">
            <thead class="table-light">
                <tr>
                    <th>Họ và tên</th>
                    <th>Email</th>
                    <th>SĐT</th>
                    <th>Nội dung</th>
                    <th>Ngày gửi</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.HoVaTen</td>
                            <td>@item.Email</td>
                            <td>@item.Sdt</td>
                            <td class="text-start">@item.NoiDung</td>
                            <td>@item.NgayGui?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <form asp-action="Xoa" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa liên hệ này không?');" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Xóa">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-muted text-center">Không có liên hệ nào</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
