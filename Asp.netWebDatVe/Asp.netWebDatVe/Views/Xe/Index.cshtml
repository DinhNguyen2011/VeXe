@model Asp.netWebDatVe.Models.Xe

@{
    ViewData["Title"] = "Chỉnh sửa xe";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="outer-container container mt-4">
    <h2 class="text-center mb-4">Danh sách Xe</h2>
    <div class="mb-3 text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Thêm Xe
        </a>
    </div>

    <div class="table-wrapper">
        <table class="table table-bordered table-striped text-center align-middle">
            <thead class="table-light">
                <tr>
                    <th>Biển số</th>
                    <th>ID Loại xe</th>
                    <th>Tên xe</th>
                    <th>Hình ảnh</th>
                    <th>Tác vụ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in ViewBag.xe)
                {
                    <tr>
                        <td>@item.Bienso</td>
                        <td>@item.IdLoai</td>
                        <td>@item.Tenxe</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.HinhAnh))
                            {
                                <img src="@Url.Content(item.HinhAnh)" alt="Ảnh @item.Tenxe" class="img-thumbnail" style="width: 100px; height: 100px; object-fit: cover;" />
                            }
                            else
                            {
                                <span class="text-muted">Không có hình ảnh</span>
                            }
                        </td>
                        <td>
                            <a asp-controller="Xe" asp-action="Edit" asp-route-id="@item.Bienso" class="btn btn-outline-primary btn-sm me-1" title="Sửa">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-controller="Xe" asp-action="Details" asp-route-id="@item.Bienso" class="btn btn-outline-info btn-sm me-1" title="Chi tiết">
                                <i class="bi bi-eye-fill"></i>
                            </a>
                            <a asp-controller="Xe" asp-action="Delete" asp-route-id="@item.Bienso" class="btn btn-outline-danger btn-sm" title="Xóa" onclick="return confirm('Bạn có chắc muốn xóa xe này không?');">
                                <i class="bi bi-trash-fill"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
