@model Asp.netWebDatVe.Models.Xe

@{
    ViewData["Title"] = "Xóa Xe";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>Xóa xe</h2>

<div class="alert alert-warning">
    <p>⚠️ Bạn có chắc chắn muốn xóa xe này không?</p>

    <table class="table table-bordered">
        <tr>
            <th>Biển số:</th>
            <td>@Html.DisplayFor(model => model.Bienso)</td>
        </tr>
        <tr>
            <th>Tên xe:</th>
            <td>@Html.DisplayFor(model => model.Tenxe)</td>
        </tr>

        @* lỗi *@
        <tr>
            <th>Loại xe:</th>
            <td>@Model.IdLoaiNavigation?.Tenloai</td>
        </tr>
        <tr>
            <th>Hình ảnh:</th>
            <td><img src="@Model.HinhAnh" width="150" height="100" alt="Hình ảnh xe" /></td>
        </tr>
    </table>

    @if (!ViewBag.CanDelete)
    {
        <div class="alert alert-danger">
            <p><strong>Không thể xóa:</strong> Xe này đang được sử dụng trong các chuyến xe.</p>
            <a asp-action="Index" class="btn btn-secondary">← Quay lại</a>
        </div>
    }
    else
    {
        <form asp-action="DeleteConfirmed" asp-route-id="@Model.Bienso" method="post">
            <button type="submit" class="btn btn-danger">Xóa</button>
            <a asp-action="Index" class="btn btn-secondary">Hủy</a>
        </form>
    }
</div>