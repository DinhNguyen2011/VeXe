@{
    ViewData["Title"] = "In Vé Xe";
    var phieuDatVe = Model as Asp.netWebDatVe.Models.PhieuDatVe;
    var veXes = phieuDatVe?.VeXes?.ToList() ?? new List<Asp.netWebDatVe.Models.VeXe>();
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<link rel="stylesheet" href="~/css/InVe.css" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

<div class="ticket-print">
    <h2 class="title">Thông tin vé xe</h2>
    <div class="ticket-info">
        <h3>Thông tin đặt vé</h3>
        <p><strong>Mã phiếu đặt vé:</strong> @phieuDatVe?.MaPhieu</p>
        <p><strong>Email khách hàng:</strong> @phieuDatVe?.Email</p>
        <p><strong>Ngày đặt:</strong> @phieuDatVe?.NgayDat?.ToString("HH:mm dd/MM/yyyy")</p>
        <p><strong>Tổng tiền:</strong> @phieuDatVe?.TongTien?.ToString("N0") VND</p>
        @if (phieuDatVe?.MaKhuyenMaiNavigation != null)
        {
            <p><strong>Khuyến mãi:</strong> Giảm @phieuDatVe.MaKhuyenMaiNavigation.PhanTramGiam% (Mã: @phieuDatVe.MaKhuyenMaiNavigation.MaKhuyenMai)</p>
        }
        <p><strong>Trạng thái:</strong> @phieuDatVe?.TrangThai</p>
    </div>

    <h3>Danh sách vé xe (@veXes.Count vé)</h3>
    @foreach (var ve in veXes)
    {
        var chuyenXe = ve.MaChuyenNavigation;
        var tuyenXe = chuyenXe?.MaTuyenNavigation;
        <div class="ticket-card">
            <h4>Vé xe #@ve.MaVe</h4>
            <p><i class="fas fa-ticket-alt"></i> <strong>Tên vé:</strong> @ve.TenVe</p>
            <p><i class="fas fa-user"></i> <strong>Tên khách hàng:</strong> @ve.TenKh</p>
            <p><i class="fas fa-chair"></i> <strong>Vị trí ghế:</strong> @ve.IdVitriNavigation?.Tenvitri</p>
            <p><i class="fas fa-map-marker-alt"></i> <strong>Tuyến:</strong> @tuyenXe?.MaBenXeDiNavigation?.TenBenXe - @tuyenXe?.MaBenXeDenNavigation?.TenBenXe</p>
            <p><i class="fas fa-clock"></i> <strong>Thời gian khởi hành:</strong> @chuyenXe?.ThoiDiemKhoiHanh?.ToString("HH:mm dd/MM/yyyy")</p>
            <p><i class="fas fa-money-bill-wave"></i> <strong>Giá vé:</strong> @chuyenXe?.GiaVe?.ToString("N0") VND</p>
            <p><i class="fas fa-info-circle"></i> <strong>Ghi chú:</strong> @ve.GhiChu</p>
            <p><i class="fas fa-phone"></i> <strong>Số điện thoại:</strong> @ve.Sđt</p>
            <p><i class="fas fa-envelope"></i> <strong>Email:</strong> @ve.Email</p>
            <p><i class="fas fa-check-circle"></i> <strong>Trạng thái:</strong> @ve.TrangThai</p>
        </div>
    }

    <div class="actions">
        <button onclick="window.print()" class="btn btn-primary"><i class="fas fa-print"></i> In vé</button>
        <a href="@Url.Action("Index", "DatVeChoKH")" class="btn btn-secondary"><i class="fas fa-home"></i> Quay lại trang chủ</a>
    </div>
</div>