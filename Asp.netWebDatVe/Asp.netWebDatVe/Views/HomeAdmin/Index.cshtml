@{
    ViewData["Title"] = "Trang quản trị";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


<h2 class="text-center mb-4">Trang tổng quan quản trị</h2>

<div class="row text-dark">
    <div class="col-md-4 mb-3">
        <div class="card bg-white border shadow-sm">
            <div class="card-body d-flex align-items-center">
                <i class="fas fa-bus fa-2x text-primary me-3"></i>
                <div>
                    <h6 class="mb-1">Tổng chuyến xe</h6>
                    <p class="fs-5 mb-0 fw-bold">@ViewBag.TongChuyenXe</p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card bg-white border shadow-sm">
            <div class="card-body d-flex align-items-center">
                <i class="fas fa-van-shuttle fa-2x text-success me-3"></i>
                <div>
                    <h6 class="mb-1">Tổng xe</h6>
                    <p class="fs-5 mb-0 fw-bold">@ViewBag.TongXe</p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card bg-white border shadow-sm">
            <div class="card-body d-flex align-items-center">
                <i class="fas fa-layer-group fa-2x text-info me-3"></i>
                <div>
                    <h6 class="mb-1">Tổng loại xe</h6>
                    <p class="fs-5 mb-0 fw-bold">@ViewBag.TongLoaiXe</p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card bg-white border shadow-sm">
            <div class="card-body d-flex align-items-center">
                <i class="fas fa-users-cog fa-2x text-warning me-3"></i>
                <div>
                    <h6 class="mb-1">Tổng nhân viên</h6>
                    <p class="fs-5 mb-0 fw-bold">@ViewBag.TongNhanVien</p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card bg-white border shadow-sm">
            <div class="card-body d-flex align-items-center">
                <i class="fas fa-user-friends fa-2x text-danger me-3"></i>
                <div>
                    <h6 class="mb-1">Tổng khách hàng</h6>
                    <p class="fs-5 mb-0 fw-bold">@ViewBag.TongKhachHang</p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card bg-white border shadow-sm">
            <div class="card-body d-flex align-items-center">
                <i class="fas fa-chart-line fa-2x text-secondary me-3"></i>
                <div>
                    <h6 class="mb-1">Doanh thu tháng @DateTime.Now.Month</h6>
                    <p class="fs-5 mb-0 fw-bold">@ViewBag.DoanhThuThang</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Biểu đồ doanh thu -->
<div class="card mt-5 shadow-sm">
    <div class="card-body">
        <h4 class="text-primary">Biểu đồ doanh thu theo tháng</h4>
        <canvas id="doanhThuChart" height="100"></canvas>
    </div>
</div>

<!-- Biểu đồ loại xe -->
<div class="card mt-5 mb-5 shadow-sm">
    <div class="card-body">
        <h4 class="text-success">Phân bố chuyến xe theo loại xe</h4>
        <div class="d-flex justify-content-center">
            <canvas id="loaiXeChart" width="400" height="400"></canvas>
        </div>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // Biểu đồ cột doanh thu
    var ctx1 = document.getElementById('doanhThuChart').getContext('2d');
    new Chart(ctx1, {
        type: 'bar',
        data: {
            labels: [@Html.Raw(ViewBag.LabelsThang)],
            datasets: [{
                label: 'Doanh thu (VNĐ)',
                data: [@Html.Raw(ViewBag.DataThang)],
                backgroundColor: 'rgba(54, 162, 235, 0.6)',
                borderColor: 'rgba(54, 162, 235, 1)',
                borderWidth: 1
            }]
        },
        options: {
            scales: {
                y: { beginAtZero: true }
            }
        }
    });

    // Biểu đồ tròn loại xe
    var ctx2 = document.getElementById('loaiXeChart').getContext('2d');
    new Chart(ctx2, {
        type: 'pie',
        data: {
            labels: [@Html.Raw(ViewBag.LabelsLoai)],
            datasets: [{
                label: 'Số chuyến',
                data: [@Html.Raw(ViewBag.DataLoai)],
                backgroundColor: [
                    'rgba(255, 99, 132, 0.6)',
                    'rgba(54, 162, 235, 0.6)',
                    'rgba(255, 206, 86, 0.6)',
                    'rgba(75, 192, 192, 0.6)',
                    'rgba(153, 102, 255, 0.6)',
                    'rgba(255, 159, 64, 0.6)'
                ]
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false
        }
    });
</script>
