@model IEnumerable<Asp.netWebDatVe.Models.Vitrighe>

@{
    ViewData["Title"] = "Danh sách vị trí ghế";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container mt-4">
    <h2 class="mb-4 text-primary"><i class="fas fa-chair"></i> Danh sách vị trí ghế</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row mb-3">
        <div class="col-md-4">
            <form asp-action="Index" method="get">
                <label for="bienso" class="form-label">Lọc theo biển số xe</label>
                <select name="bienso" id="bienso" class="form-select" onchange="this.form.submit()">
                    <option value="">Tất cả</option>
                    @foreach (var item in ViewBag.BiensoList)
                    {
                        <option value="@item.Value" selected="@(item.Selected ? "selected" : null)">
                            @item.Text
                        </option>
                    }
                </select>
            </form>
        </div>
        <div class="col-md-8 text-end">
            <a asp-action="Create" class="btn btn-primary mt-4">
                <i class="fas fa-plus-circle"></i> Thêm vị trí ghế
            </a>
        </div>
    </div>

    <h5 class="text-secondary mb-3"><i class="fas fa-undo-alt"></i> Đặt lại trạng thái ghế theo xe</h5>

    <div class="mb-4">
        @foreach (var bienso in Model.Select(v => v.Bienso).Distinct())
        {
            <form asp-action="ResetSeatsByBienso" method="post" class="d-inline"
                  onsubmit="return confirm('Bạn có chắc chắn muốn đặt lại tất cả ghế của xe @bienso thành trống không?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bienso" value="@bienso" />
                <button type="submit" class="btn btn-secondary btn-sm mb-1">
                    <i class="fas fa-redo"></i> Đặt lại xe @bienso
                </button>
            </form>
        }
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr class="text-center">
                <th>Mã vị trí</th>
                <th>Biển số xe</th>
                <th>Tên vị trí</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="align-middle text-center">
                    <td>@item.IdVitri</td>
                    <td>@item.Bienso</td>
                    <td>@item.Tenvitri</td>
                    <td>
                  @*   <td>@(item.Trangthai == true ? "Đã đặt" : "Trống")</td> *@
                        @if (item.Trangthai == true)
                        {
                            <span class="badge bg-danger"><i class="fas fa-times-circle"></i> Đã đặt</span>
                        }
                        else
                        {
                            <span class="badge bg-success"><i class="fas fa-check-circle"></i> Trống</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.IdVitri" class="btn btn-warning btn-sm me-1" title="Sửa">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.IdVitri" class="btn btn-danger btn-sm" title="Xóa">
                            <i class="fas fa-trash-alt"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>



