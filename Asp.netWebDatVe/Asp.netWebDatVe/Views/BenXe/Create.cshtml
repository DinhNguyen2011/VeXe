@model Asp.netWebDatVe.Models.BenXe

@{
    ViewData["Title"] = "Thêm bến xe";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<link rel="stylesheet" href="~/css/BenXe.css" />

<div class="benxe-container">
    <h2 class="benxe-title">Thêm bến xe</h2>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group benxe-form-group">
            <label asp-for="TenBenXe" class="benxe-label"></label>
            <input asp-for="TenBenXe" class="form-control benxe-input" />
            <span asp-validation-for="TenBenXe" class="text-danger"></span>
        </div>

        <div class="form-group benxe-form-group">
            <label asp-for="DiaChi" class="benxe-label"></label>
            <input asp-for="DiaChi" class="form-control benxe-input" />
            <span asp-validation-for="DiaChi" class="text-danger"></span>
        </div>

        <div class="form-group benxe-form-group">
            <label asp-for="Sdt" class="benxe-label"></label>
            <input asp-for="Sdt" class="form-control benxe-input" />
            <span asp-validation-for="Sdt" class="text-danger"></span>
        </div>

        <div class="form-group benxe-form-group">
            <label asp-for="ThanhPho" class="benxe-label"></label>
            <input asp-for="ThanhPho" class="form-control benxe-input" />
            <span asp-validation-for="ThanhPho" class="text-danger"></span>
        </div>

        <div class="form-group benxe-form-group">
            <button type="submit" class="btn btn-primary benxe-btn">Thêm</button>
            <a asp-action="Index" class="btn btn-secondary benxe-btn">Quay lại</a>
        </div>
    </form>
</div>
