@model IEnumerable<Asp.netWebDatVe.Models.BenXe>

@{
    ViewData["Title"] = "Danh sách bến xe";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<link rel="stylesheet" href="~/css/BenXe.css" />

<div class="container my-4 benxe-container">

    <h2 class="mb-4 benxe-title">🚏 Danh sách bến xe</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show benxe-alert" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show benxe-alert" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i> Thêm bến xe
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover benxe-table align-middle text-center">
            <thead class="table-light">
                <tr>
                    <th>Mã bến xe</th>
                    <th>Tên bến xe</th>
                    <th>Địa chỉ</th>
                    <th>Số điện thoại</th>
                    <th>Thành phố</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MaBenXe</td>
                        <td>@item.TenBenXe</td>
                        <td>@item.DiaChi</td>
                        <td>@item.Sdt</td>
                        <td>@item.ThanhPho</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.MaBenXe" class="btn btn-outline-warning btn-sm me-1" title="Sửa">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.MaBenXe" class="btn btn-outline-danger btn-sm" title="Xóa" onclick="return confirm('Bạn có chắc muốn xóa bến xe này không?');">
                                <i class="bi bi-trash3"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
