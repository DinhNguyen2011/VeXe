@model Asp.netWebDatVe.Models.PhieuDatVe

@{
    ViewData["Title"] = "Tra cứu vé";
}
<link rel="stylesheet" href="~/css/TraCuuPhieuDatVe.css" />
@* <h4 style="color:#00ff34 !important">TRA CỨU THÔNG TIN ĐẶT VÉ</h4> *@

<div class="lookup-container" >
  
    <form id="lookupForm" method="post">
        <div class="form-group">
            @* <label for="maVe">Mã vé:</label> *@
            <input asp-for="MaPhieu"  type="text" id="maVe" name="maVe" placeholder="Nhập mã phiếu của bạn"  />
        </div>
        <div class="form-group">
            @* <label for="email">Email:</label> *@
            <input asp-for="Email" type="email" id="email" name="email" placeholder="Nhập email của bạn"  />
        </div>
        <button type="submit" class="btn-submit">Tra cứu</button>
    </form>


    @if (ViewBag.Message != null)
    {
        <div class="alert-message error">
            @ViewBag.Message
        </div>
    }

    @if (ViewBag.PhieuDatVe != null)
    {
        var phieu = ViewBag.PhieuDatVe as Asp.netWebDatVe.Models.PhieuDatVe;
        <div class="result-container" style="color:red !important;">
            <h2>Thông Tin Phiếu Đặt Vé</h2>
            <table class="result-table">
                <tr>
                    <th>Mã Phiếu:</th>
                    <td>@phieu.MaPhieu</td>
                </tr>
                <tr>
                    <th>Email:</th>
                    <td>@phieu.Email</td>
                </tr>
                <tr>
                    <th>Ngày Đặt:</th>
                    <td>@phieu.NgayDat?.ToString("dd/MM/yyyy")</td>
                </tr>
                <tr>
                    <th>Tổng Tiền:</th>
                    <td>@phieu.TongTien?.ToString("N0") VND</td>
                </tr>
                <tr>
                    <th>Trạng Thái:</th>
                    <td>@phieu.TrangThai</td>
                </tr>
            </table>
        </div>
    }
</div>
