@model IEnumerable<Asp.netWebDatVe.Models.VeXe>

@{
    ViewData["Title"] = "Danh sách vé xe";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<style>
    .table-wrapper {
        max-width: 100%;
        height: 500px;
        overflow-y: auto;
        margin: 20px auto;
        border: 1px solid #ddd;
        background-color: #f9f9f9;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        padding: 1rem;
    }

    .table {
        font-size: 13px;
        width: 100%;
        border-collapse: collapse;
    }

        .table th,
        .table td {
            padding: 8px;
            text-align: center;
            vertical-align: middle;
            border: 1px solid #ddd;
        }

        .table th {
       
            color: darkslategray;
            font-weight: 500;
        }

    .btn-sm {
        font-size: 12px;
        padding: 4px 8px;
    }

    .btn-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
    }

    .action-column {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
    }

    .heading-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }
</style>

<div class="heading-section">
    <h2>🎫 Danh sách vé xe</h2>
    <div>
        <a asp-action="ThongKeDoanhThu" class="btn btn-success btn-sm me-2">
            <i class="bi bi-bar-chart-line-fill me-1"></i> Doanh thu
        </a>
        <a asp-action="VeHuy" class="btn btn-secondary btn-sm">
            <i class="bi bi-x-circle me-1"></i> Vé bị hủy
        </a>
    </div>
</div>

<div class="table-wrapper">
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Mã vé</th>
                <th>Tên vé</th>
                <th>Tên KH</th>
                <th>Email</th>
                <th>Chuyến</th>
                <th>Giá vé</th>
                <th>Vị trí</th>
                <th>Trạng thái</th>
                <th>Ngày đặt</th>
                <th>Tác vụ</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaVe</td>
                    <td>@item.TenVe</td>
                    <td>@item.TenKh</td>
                    <td>@item.Email</td>
                    <td>@item.MaChuyenNavigation?.TenChuyenXe</td>
                    <td>@item.MaChuyenNavigation?.GiaVe?.ToString("N0") VNĐ</td>
                    <td>@item.IdVitriNavigation?.Tenvitri</td>
                    <td>@item.TrangThai</td>
                    <td>@item.NgayDat?.ToString("dd/MM/yyyy")</td>
                    <td>
                        <div class="action-column">
                            <a asp-action="Details" asp-route-id="@item.MaVe"
                               class="btn btn-outline-info btn-sm btn-icon"
                               title="Xem chi tiết">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.MaVe"
                               class="btn btn-outline-danger btn-sm btn-icon"
                               title="Xóa vé"
                               onclick="return confirm('Bạn có chắc chắn muốn xóa vé này không?');">
                                <i class="bi bi-trash3"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
