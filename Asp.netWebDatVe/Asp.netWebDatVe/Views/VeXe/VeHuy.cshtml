@model IEnumerable<Asp.netWebDatVe.Models.VeXe>

@{
    ViewData["Title"] = "Danh sách vé đã hủy";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

}

<h1>Danh sách vé đã hủy</h1>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.MaVe)</th>
            <th>@Html.DisplayNameFor(model => model.MaChuyenNavigation.TenChuyenXe)</th>
            <th>@Html.DisplayNameFor(model => model.IdVitriNavigation.Tenvitri)</th>
            <th>@Html.DisplayNameFor(model => model.MaPhieuNavigation.MaPhieu)</th>
            <th>@Html.DisplayNameFor(model => model.NgayDat)</th>
            <th>@Html.DisplayNameFor(model => model.TrangThai)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.MaVe)</td>
                <td>@Html.DisplayFor(modelItem => item.MaChuyenNavigation.TenChuyenXe)</td>
                <td>@Html.DisplayFor(modelItem => item.IdVitriNavigation.Tenvitri)</td>
                <td>@Html.DisplayFor(modelItem => item.MaPhieuNavigation.MaPhieu)</td>
                <td>@Html.DisplayFor(modelItem => item.NgayDat)</td>
                <td>@Html.DisplayFor(modelItem => item.TrangThai)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.MaVe">Chi tiết</a> |
                    <a asp-action="Delete" asp-route-id="@item.MaVe">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-action="Index">Quay lại danh sách vé</a>
</div>