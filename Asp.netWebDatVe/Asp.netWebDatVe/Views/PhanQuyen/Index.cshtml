@model IEnumerable<Asp.netWebDatVe.Models.PhanQuyen>

@{
    ViewData["Title"] = "Danh sách phân quyền";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


<div class="container mt-4">
    <h2 class="text-center mb-4">Danh sách phân quyền</h2>

    <div class="text-end mb-3">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Thêm phân quyền mới
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped text-center align-middle">
            <thead class="table-light">
                <tr>
                    <th>Mã quyền</th>
                    <th>Tên quyền</th>
                    <th>Tác vụ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MaQuyen</td>
                        <td>@item.TenQuyen</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.MaQuyen" class="btn btn-outline-primary btn-sm me-1" title="Sửa">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.MaQuyen" class="btn btn-outline-danger btn-sm" title="Xóa" onclick="return confirm('Bạn có chắc muốn xóa quyền này không?');">
                                <i class="bi bi-trash-fill"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
