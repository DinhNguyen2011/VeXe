<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Quản lý Bán Vé Xe Khách</title>
    <!-- plugins:css -->
    <link rel="stylesheet" href="../../LayoutAdmin/assets/vendors/mdi/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="../../LayoutAdmin/assets/vendors/css/vendor.bundle.base.css">
    <!-- Layout styles -->
    <link rel="stylesheet" href="../../LayoutAdmin/assets/css/style.css">
    <link rel="shortcut icon" href="../../LayoutAdmin/assets/images/favicon.ico" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />


</head>
<body>
    <div class="container-scroller">
        <nav class="navbar default-layout-navbar col-lg-12 col-12 p-0 fixed-top d-flex flex-row">
            <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-center">
                <a class="navbar-brand brand-logo" href="@Url.Action("Index","HomeAdmin")"><img src="../../LayoutAdmin/assets/images/main-lg.png" alt="logo" style="height:60px; width:250px !important; border-radius:8px !important; " /></a>
                <a class="navbar-brand brand-logo-mini" href="@Url.Action("Index","HomeAdmin")"><img src="../../LayoutAdmin/assets/images/logo-mini.svg" alt="logo" /></a>
            </div>
            <div class="navbar-menu-wrapper d-flex align-items-stretch">
                <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-toggle="minimize">
                    <span class="mdi mdi-menu"></span>
                </button>
                <ul class="navbar-nav navbar-nav-right">
                    <li class="nav-item nav-profile dropdown">
                        <a class="nav-link dropdown-toggle" id="profileDropdown" href="#" data-bs-toggle="dropdown">
                            <div class="nav-profile-text">
                                <p class="mb-1 text-black"> Hi, @ViewData["UserName"]</p>
                            </div>
                        </a>
                        <div class="dropdown-menu navbar-dropdown" aria-labelledby="profileDropdown">
                            <a class="dropdown-item" href="#">
                                <i class="mdi mdi-cached me-2 text-success"></i>Xem thông tin
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" asp-controller="Account" asp-action="Logout">
                                <i class="mdi mdi-logout me-2 text-primary"></i> Đăng xuất
                            </a>
                        </div>
                    </li>
                </ul>
            </div>
        </nav>

        <div class="container-fluid page-body-wrapper">
            <!-- Sidebar -->
            <nav class="sidebar sidebar-offcanvas" id="sidebar">
                <ul class="nav">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "HomeAdmin")">
                            <span class="menu-title">Trang chủ</span>
                            <i class="mdi mdi-home menu-icon"></i>
                        </a>
                    </li>

                   

                

                    <!-- Nhóm Quản lý đặt vé -->
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#ticket-management" role="button" aria-expanded="false" aria-controls="ticket-management">
                            <span class="menu-title">Quản lý đặt vé</span>
                            <i class="menu-arrow"></i>
                            <i class="mdi mdi-ticket-confirmation menu-icon"></i>
                        </a>
                        <div class="collapse" id="ticket-management">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "DatVeChoKH")">Đặt vé cho khách</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "PhieuDatVe")">Phiếu đặt vé</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "VeXe")">Vé xe</a>
                                </li>
                            </ul>
                        </div>
                    </li>
                    <!-- Nhóm Quản lý phương tiện -->
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#vehicle-management" role="button" aria-expanded="false" aria-controls="vehicle-management">
                            <span class="menu-title">Quản lý phương tiện</span>
                            <i class="menu-arrow"></i>
                            <i class="mdi mdi-bus menu-icon"></i>
                        </a>
                        <div class="collapse" id="vehicle-management">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "Xe")">Quản lý xe</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "LoaiXe")">Quản lý loại xe</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "Vitrighe")">Quản lý vị trí ghế</a>
                                </li>
                            </ul>
                        </div>
                    </li>
                    <!-- Nhóm Quản lý tuyến/chuyến -->
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#route-management" role="button" aria-expanded="false" aria-controls="route-management">
                            <span class="menu-title">Quản lý tuyến/chuyến</span>
                            <i class="menu-arrow"></i>
                            <i class="mdi mdi-road-variant menu-icon"></i>
                        </a>
                        <div class="collapse" id="route-management">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "BenXe")">Quản lý bến xe</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "TuyenXe")">Quản lý tuyến xe</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "ChuyenXe")">Quản lý chuyến xe</a>
                                </li>


                            </ul>
                        </div>
                    </li>
                    <!-- Nhóm Quản lý người dùng -->
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#user-management" role="button" aria-expanded="false" aria-controls="user-management">
                            <span class="menu-title">Quản lý người dùng</span>
                            <i class="menu-arrow"></i>
                            <i class="mdi mdi-account-multiple menu-icon"></i>
                        </a>
                        <div class="collapse" id="user-management">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "NhanVien")">Quản lý nhân viên</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "NguoiDung")">Quản lý khách hàng</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "PhanQuyen")">Quản lý phân quyền</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("DanhSach", "LienHeVoiChungToi")">Quản lý liên hệ</a>
                                </li>
                            </ul>
                        </div>
                    </li>

                    <!-- Nhóm Quản lý hệ thống -->
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#system-management" role="button" aria-expanded="false" aria-controls="system-management">
                            <span class="menu-title">Thanh toán & khuyến mãi</span>
                            <i class="menu-arrow"></i>
                            <i class="mdi mdi-cog-outline menu-icon"></i>
                        </a>
                        <div class="collapse" id="system-management">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "KhuyenMai")">Quản lý khuyến mãi</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "ThanhToan")">Quản lý thanh toán</a>
                                </li>
                            </ul>
                        </div>
                    </li>

                </ul>
            </nav>


            <div class="main-panel">
                <div class="content-wrapper">
                    @RenderBody()
                </div>
                <footer class="footer">
                </footer>
            </div>
        </div>
    </div>

    <!-- plugins:js -->
    <script src="../../LayoutAdmin/assets/vendors/js/vendor.bundle.base.js"></script>
    <!-- inject:js -->
    <script src="../../LayoutAdmin/assets/js/off-canvas.js"></script>
    <script src="../../LayoutAdmin/assets/js/hoverable-collapse.js"></script>
    <script src="../../LayoutAdmin/assets/js/misc.js"></script>

    <!-- Render section Scripts -->
    @RenderSection("Scripts", required: false)
</body>
</html>