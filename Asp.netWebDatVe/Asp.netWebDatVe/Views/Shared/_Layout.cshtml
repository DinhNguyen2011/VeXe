<!DOCTYPE html>
<html>
<head>
    <title data-lang-key="title">Khánh An - Đặt Vé Xe Khách Online</title>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="format-detection" content="telephone=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="author" content="Futabus">
    <meta name="keywords" content="Đặt vé xe khách, Vé xe Phương Trang, Xe khách, Vé xe online" data-lang-key="meta_keywords">
    <meta name="description" content="Đặt vé xe khách Phương Trang nhanh chóng, dễ dàng qua hệ thống online của chúng tôi." data-lang-key="meta_description">
    <style>
        .footer h5 {
            font-weight: 700;
            margin-bottom: 1rem;
            font-size: 1.1rem;
        }

        .footer ul li {
            margin-bottom: 0.5rem;
        }

            .footer ul li a:hover {
                color: #28a745 !important;
            }

        .footer iframe {
            border-radius: 10px;
        }
    </style>
    <!-- Bootstrap -->
    <link rel="stylesheet" type="text/css" href="~/css/bootstrap.min.css">
    <!-- Vendor CSS -->
    <link rel="stylesheet" type="text/css" href="~/css/vendor.css">
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css" />
    <!-- AOS CSS -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <!-- Style Sheet -->
    <link rel="stylesheet" type="text/css" href="~/css/style.css">
    <link rel="stylesheet" type="text/css" href="~/css/layout.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Upright:wght@300;400;500;600;700&family=Sora:wght@100..800&display=swap" rel="stylesheet">
</head>


<body style="background-color:#ffffff !important">
    <div class="preloader">
        <div class="loader"></div>
    </div>
    <div class="bg-light py-2 border-bottom" style="padding-right:3.5rem!important;padding-left:3.5rem!important">
        <div class="container-fluid d-flex justify-content-between align-items-center px-4">
            <div class="d-flex align-items-center flex-wrap">
                <span class="me-4">
                    <i class="fa-brands fa-facebook me-2"></i> <a href="https://facebook.com/khanhan" target="_blank" class="text-success text-decoration-none" data-lang-key="fanpage">Fanpage</a>
                </span>
                <span class="mx-3">|</span>
                <span><i class="fa-solid fa-envelope me-2"></i> khanhanbus@gmail.com</span>
            </div>
            <div class="d-flex" style="padding-right: 4rem !important;">
                <div class="fw-bold text-uppercase" data-lang-key="company_name">Khánh An Limousine</div>
            </div>
        </div>
    </div>

    <header id="header">
        <nav id="primary-header" class="navbar navbar-expand-lg py-4">
            <div class="container-fluid padding-side">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <!-- Logo và chọn ngôn ngữ -->
                    <div class="d-flex align-items-center">
                        <!--trở về-->
                        <a class="navbar-brand" href="@Url.Action("Index", "Home")"> 
                            @* <img src="~/images/main.png">  *@
                            <img src="~/images/main-lg.png" class="logo img-fluid" style="width: 200px;height: 70px; border-radius:10px;">
                        </a>
                        <!-- Chọn ngôn ngữ bằng hình ảnh cờ -->
                        <div class="language-switch ms-3">
                            <a href="#" class="language-flag active" data-lang="vi" title="Tiếng Việt">
                                <img src="~/images/vn-flag.png" alt="Vietnam Flag" class="flag-icon">
                            </a>
                            <!---->
                            <a href="#" class="language-flag" data-lang="en" title="English">
                                <img src="~/images/uk-flag.png" alt="UK Flag" class="flag-icon">
                            </a>
                        </div>
                    </div>
                    <button class="navbar-toggler border-0 d-flex d-lg-none order-3 p-2 shadow-none" type="button"
                            data-bs-toggle="offcanvas" data-bs-target="#bdNavbar" aria-controls="bdNavbar" aria-expanded="false">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="header-bottom offcanvas offcanvas-end" id="bdNavbar" aria-labelledby="bdNavbarOffcanvasLabel">
                        <div class="offcanvas-header px-4 pb-0">
                            <button type="button" class="btn-close btn-close-black mt-2" data-bs-dismiss="offcanvas"
                                    aria-label="Close" data-bs-target="#bdNavbar"></button>
                        </div>
                        <div class="offcanvas-body align-items-center justify-content-center" style="padding-left: 80px !important; font-size: 14px !important;">
                            <ul class="navbar-nav align-items-center mb-2 mb-lg-0">
                                <li class="nav-item px-2">
                                    @* href="@Url.Action("Index", "Home")"  tương tự (thay thế bt)  asp-controller="LichTrinh" asp-action="Index" *@
                                    <a class="nav-link" aria-current="page" href="@Url.Action("Index", "Home")" data-lang-key="menu_home">Trang chủ</a>
                                </li>
                                <li class="nav-item px-2">
                                    <a class="nav-link @(ViewData["Title"] as string == "Lịch Trình" ? "active" : "")" asp-controller="LichTrinh" asp-action="Index" data-lang-key="menu_schedule">Lịch trình</a>
                                </li>
                                <li class="nav-item px-2">
                                    <a class="nav-link @(ViewData["Title"] as string == "Tra cứu vé" ? "active" : "")" asp-controller="TraCuuPhieuDatVe" asp-action="Index" data-lang-key="menu_ticket_lookup">Tra cứu vé</a>
                                </li>
                                <li class="nav-item px-2">
                                    <a class="nav-link @(ViewData["Title"] as string == "Blog" ? "active" : "")" asp-controller="VanChuyen" asp-action="Index" data-lang-key="menu_transport">Vận Chuyển</a>
                                </li>
                                <li class="nav-item px-2">
                                    <a class="nav-link @(ViewData["Title"] as string == "Liên hệ" ? "active" : "")" asp-controller="LienHeVoiChungToi" asp-action="Index" data-lang-key="menu_contact">Liên hệ</a>
                                </li>
                                <li class="nav-item px-2">
                                    <a class="nav-link @(ViewData["Title"] as string == "Về chúng tôi" ? "active" : "")" asp-controller="VeChungToi" asp-action="Index" data-lang-key="menu_about">Về chúng tôi</a>
                                </li>

                               @*  accoutcontrolller 101  *@
                                @if (ViewData["UserName"] != null)
                                {
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <span data-lang-key="menu_hi">Hi</span>, @(ViewData["UserName"].ToString().Length > 4 ? ViewData["UserName"].ToString().Substring(0, 4) + "..." : ViewData["UserName"])
                                        </a> <!--hiển thị tên ng dùng giới hạn 4 ký tự-->
                                        <!--dropdown | xuống profile -->
                                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile" data-lang-key="menu_profile">Xem thông tin</a></li>
                                            <li><a class="dropdown-item" asp-controller="XuLyPhieuDatVe" asp-action="XemCacPhieuDatVe" data-lang-key="menu_view_bookings">Xem các phiếu đặt vé</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout" data-lang-key="menu_logout">Đăng xuất</a></li>
                                        </ul>
                                    </li>
                                }
                                else
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Account" asp-action="Login" data-lang-key="menu_login_register">Đăng nhập/Đăng ký</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!---------------------------------------->

    <!--Home -->
    <div class="container" style="max-width:1455px !important">
        @RenderBody()
    </div> 

    <!---------------------------------------->

    <section id="footer" class="footer bg-light pt-5">
        <div class="container">
            <div class="row">
                <!-- Cột 1: Logo và tên -->
                <div class="col-lg-3 mb-4">
                    <img src="~/images/main-lg.png" alt="logo-footer" class="img-fluid mb-2" style="width: 180px; border-radius:10px;">
                    <p class="fw-bold text-success mb-0" data-lang-key="footer_company_name">CÔNG TY TNHH TM & DV</p>
                    <p class="fw-bold text-success mb-2" data-lang-key="footer_company_name_sub">KHÁNH AN LIMOUSINE</p>
                    <p class="small text-muted" data-lang-key="footer_license">GPKD số 0123456789 do Sở KH&ĐT TP.HCM cấp ngày 22/06/2025</p>
                    <a href="#"><img src="~/images/dathongbao.png" alt="Đã thông báo Bộ Công Thương" class="img-fluid" width="150" data-lang-key="footer_ministry_notification"></a>
                </div>
                <!-- Cột 2: Văn phòng -->
                <div class="col-lg-3 mb-4">
                    <h5 class="fw-bold text-success" data-lang-key="footer_offices">Hệ thống văn phòng</h5>
                    <ul class="list-unstyled small text-muted">
                        <li><i class="fa fa-map-marker-alt me-2 text-success"></i> <span data-lang-key="footer_office_sg">VP Sài Gòn: 123 Đinh Tiên Hoàng, Q1</span></li>
                        <li><i class="fa fa-map-marker-alt me-2 text-success"></i> <span data-lang-key="footer_office_dl">VP Đà Lạt: 456 Bùi Thị Xuân, Đà Lạt</span></li>
                        <li><i class="fa fa-map-marker-alt me-2 text-success"></i> <span data-lang-key="footer_office_nt">VP Nha Trang: 789 Lê Thánh Tôn</span></li>
                    </ul>
                </div>
                <!-- Cột 3: Chính sách -->
                <div class="col-lg-3 mb-4">
                    <h5 class="fw-bold text-success" data-lang-key="footer_policies">Chính sách dịch vụ</h5>
                    <ul class="list-unstyled small text-muted">
                        <li><a href="#" class="text-decoration-none text-muted" data-lang-key="footer_check_ticket">Kiểm tra vé</a></li>
                        <li><a href="#" class="text-decoration-none text-muted" data-lang-key="footer_order_lookup">Tra cứu đơn hàng</a></li>
                        <li><a href="#" class="text-decoration-none text-muted" data-lang-key="footer_cancellation_policy">Chính sách hủy/đổi vé</a></li>
                        <li><a href="#" class="text-decoration-none text-muted" data-lang-key="footer_payment_methods">Hình thức thanh toán</a></li>
                    </ul>
                </div>

                
                <div class="col-lg-3 mb-4">
                    <h5 class="fw-bold text-success" data-lang-key="footer_fanpage">Fanpage Khánh An</h5>
                    <div class="mb-2">
                        <iframe src="https://www.facebook.com/plugins/page.php?href=https://www.facebook.com/xephuongtrang&tabs=timeline&width=300&height=150&small_header=false&adapt_container_width=true&hide_cover=false&show_facepile=true"
                           @*   <iframe src="https://www.facebook.com/plugins/page.php?href=https://www.facebook.com/xephuongtrang  *@
                        width="100%" height="150" style="border:none;overflow:hidden" scrolling="no"
                                frameborder="0" allowfullscreen="true"
                                allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share">
                        </iframe>
                    </div>
                    <img src="~/images/khuyenmai.png" class="img-fluid rounded" alt="Khuyến mãi xe" data-lang-key="footer_promotion_alt">
                </div>
            </div>
            <hr>
            <div class="row small text-muted">
                <div class="col-md-6">
                    <p class="mb-0" data-lang-key="footer_copyright">© 2025 Khánh An Limousine. All rights reserved.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <ul class="list-inline mb-0">
                        <li class="list-inline-item"><a href="#" class="text-muted" data-lang-key="footer_privacy_policy">Chính sách bảo mật</a></li>
                        <li class="list-inline-item"><a href="#" class="text-muted" data-lang-key="footer_terms_of_use">Điều khoản sử dụng</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    @* js *@
    <script src="~/js/jquery-1.11.0.min.js"></script>
    <script type="text/javascript" src="~/js/bootstrap.bundle.min.js"></script>
    <script type="text/javascript" src="~/js/plugins.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper/swiper-bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script type="text/javascript" src="~/js/script.js"></script>
    <script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>




