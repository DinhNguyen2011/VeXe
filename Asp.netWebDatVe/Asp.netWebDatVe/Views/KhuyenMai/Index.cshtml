@model IEnumerable<Asp.netWebDatVe.Models.KhuyenMai>

@{
    ViewData["Title"] = "Quản lý khuyến mãi";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<link rel="stylesheet" href="~/css/Vitrighe.css" />

<div class="vitrighe-container">
    <h2 class="vitrighe-title">Quản lý khuyến mãi</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success vitrighe-alert">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger vitrighe-alert">@TempData["Error"]</div>
    }

    <p>
        <a asp-action="Create" class="btn btn-primary vitrighe-btn">Thêm khuyến mãi</a>
    </p>

    <table class="table table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Tên khuyến mãi</th>
                <th>Mô tả</th>
                <th>Phần trăm giảm</th>
                <th>Ngày bắt đầu</th>
                <th>Ngày kết thúc</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.TenKhuyenMai)</td>
                    <td>@Html.DisplayFor(modelItem => item.MoTa)</td>
                    <td>@Html.DisplayFor(modelItem => item.PhanTramGiam)%</td>
                    <td>@item.NgayBatDau.ToString("dd/MM/yyyy")</td>
                    <td>@item.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.MaKhuyenMai" class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.MaKhuyenMai" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>