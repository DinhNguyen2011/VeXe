@model IEnumerable<Asp.netWebDatVe.Models.KhuyenMai>
@{
    ViewData["Title"] = "Quản lý Khuyến Mãi";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2>Quản lý Khuyến Mãi</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Thêm Khuyến Mãi</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.TenKhuyenMai)</th>
            <th>@Html.DisplayNameFor(model => model.MoTa)</th>
            <th>@Html.DisplayNameFor(model => model.PhanTramGiam)</th>
            <th>@Html.DisplayNameFor(model => model.NgayBatDau)</th>
            <th>@Html.DisplayNameFor(model => model.NgayKetThuc)</th>
            <th>@Html.DisplayNameFor(model => model.HinhAnh)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in ViewBag.km)
        {
            <tr>
                <td>@item.TenKhuyenMai</td>
                <td>@item.MoTa</td>
                <td>@item.PhanTramGiam%</td>
                <td>@item.NgayBatDau.ToString("dd/MM/yyyy")</td>
                <td>@item.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.HinhAnh))
                    {
                        <img src="@Url.Content(item.HinhAnh)" alt="Hình ảnh khuyến mãi" style="max-width: 100px;" />
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.MaKhuyenMai">Chi tiết</a> |
                    <a asp-action="Edit" asp-route-id="@item.MaKhuyenMai">Sửa</a> |
                    <a asp-action="Delete" asp-route-id="@item.MaKhuyenMai">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>