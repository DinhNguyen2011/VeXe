@model Asp.netWebDatVe.Models.KhuyenMai

@{
    ViewData["Title"] = "Xóa khuyến mãi";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<link rel="stylesheet" href="~/css/Vitrighe.css" />

<div class="vitrighe-container">
    <h2 class="vitrighe-title">Xóa khuyến mãi</h2>

    <h3>Bạn có chắc chắn muốn xóa khuyến mãi này?</h3>
    <div>
        <h4>@Html.DisplayFor(model => model.TenKhuyenMai)</h4>
        <dl class="row">
            <dt class="col-sm-2">Mô tả</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.MoTa)</dd>
            <dt class="col-sm-2">Phần trăm giảm</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.PhanTramGiam)%</dd>
            <dt class="col-sm-2">Ngày bắt đầu</dt>
            <dd class="col-sm-10">@Model.NgayBatDau.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-2">Ngày kết thúc</dt>
            <dd class="col-sm-10">@Model.NgayKetThuc.ToString("dd/MM/yyyy")</dd>
        </dl>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MaKhuyenMai" />
            <button type="submit" class="btn btn-danger vitrighe-btn">Xóa</button>
            <a asp-action="Index" class="btn btn-secondary vitrighe-btn">Quay lại</a>
        </form>
    </div>
</div>