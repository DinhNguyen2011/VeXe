@model Asp.netWebDatVe.Models.NguoiDung

@{
    ViewData["Title"] = "Quản lý người dùng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Link Bootstrap Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<h1 class="text-center">Danh sách người dùng</h1>

<div class="text-center mt-4">
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Thêm người dùng mới
    </a>
</div>

<div class="container mt-3">
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle text-center">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Email</th>
                    <th>SĐT</th>
                    <th>Họ và tên</th>
                    <th>Ngày sinh</th>
@*                     <th>Địa chỉ</th>
                    <th>Quyền</th>
                    <th>Hình ảnh</th> *@
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.nd != null)
                {
                    foreach (var nguoiDung in ViewBag.nd)
                    {
                        <tr>
                            <td>@nguoiDung.Id</td>
                            <td>@nguoiDung.Email</td>
                            <td>@nguoiDung.Sdt</td>
                            <td>@nguoiDung.HoTen</td>
                            <td>@nguoiDung.NgaySinh?.ToString("dd/MM/yyyy")</td>
                         @*    <td>@nguoiDung.DiaChi</td>
                            <td>@nguoiDung.MaQuyenNavigation?.TenQuyen</td>
                            <td>
                                @if (!string.IsNullOrEmpty(nguoiDung.HinhAnh))
                                {
                                    <img src="@Url.Content(nguoiDung.HinhAnh)" alt="Hình ảnh của @nguoiDung.HoTen" class="img-fluid rounded" style="max-width: 100px; max-height: 100px;" />
                                }
                                else
                                {
                                    <span class="text-muted">Không có hình</span>
                                }
                            </td> *@
                            <td>
                                <a asp-controller="NguoiDung" asp-action="Edit" asp-route-id="@nguoiDung.Id" class="btn btn-outline-primary btn-sm me-1" title="Sửa">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-controller="NguoiDung" asp-action="Details" asp-route-id="@nguoiDung.Id" class="btn btn-outline-info btn-sm me-1" title="Chi tiết">
                                    <i class="bi bi-eye-fill"></i>
                                </a>
                                <a asp-controller="NguoiDung" asp-action="Delete" asp-route-id="@nguoiDung.Id" class="btn btn-outline-danger btn-sm" title="Xóa" onclick="return confirm('Bạn có chắc muốn xóa người dùng này không?');">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted">Không có dữ liệu</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
