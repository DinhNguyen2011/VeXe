@{
    ViewData["Title"] = "Chọn ghế";
    var chuyenXe = ViewBag.ChuyenXe;
    var danhSachGhe = ViewBag.DanhSachGhe as IEnumerable<dynamic>;
    var gheDaDat = ViewBag.GheDaDat as List<int> ?? new List<int>();
    int soGhe = ViewBag.SoGhe ?? 0;
    int soGheTren = soGhe / 2;
    var giaVe = chuyenXe?.GiaVe ?? 0;
}

<link rel="stylesheet" href="~/css/Cg.css" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

<div class="chon-ghe-container" style="margin:50px 0px;">
    <h2 class="chon-ghe-title" style="color:#00ff34 !important" data-lang-key="chon_ghe_subtitle">Chọn ghế và điền thông tin</h2>

    <div class="chon-ghe-legend">
        <div><span class="chon-ghe-icon-box chon-ghe-available"></span> Còn trống</div>
        <div><span class="chon-ghe-icon-box chon-ghe-occupied"></span> Đã đặt</div>
        <div><span class="chon-ghe-icon-box chon-ghe-selected"></span> Đang chọn</div>
    </div>

    <div class="row">
        <!-- Cột bên trái: Ghế -->
        <div class="col-md-8">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <!-- Tầng trên -->
            <div class="chon-ghe-section">
                <h3 class="chon-ghe-section-title">Tầng trên</h3>
                <div class="row chon-ghe-hang">
                    @{
                        var gheTangTren = danhSachGhe.Take(soGheTren).ToList();
                        int ghePerColTren = (int)Math.Ceiling(gheTangTren.Count / 3.0);
                    }
                    @for (int i = 0; i < 3; i++)
                    {
                        var gheCol = gheTangTren.Skip(i * ghePerColTren).Take(ghePerColTren);
                        <div class="col-md-4 chon-ghe-cot">
                            @foreach (var ghe in gheCol)
                            {
                                var isBooked = gheDaDat.Contains(ghe.IdVitri);
                                <button class="chon-ghe-seat @(isBooked ? "chon-ghe-occupied" : "chon-ghe-available")"
                                        @(isBooked ? "disabled" : "")
                                        data-id="@ghe.IdVitri"
                                        title="Ghế @ghe.Tenvitri @(isBooked ? "(Đã đặt)" : "(Còn trống)")">
                                    <i class="fas fa-chair chon-ghe-icon"></i>
                                    <span class="chon-ghe-number">@ghe.Tenvitri</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Tầng dưới -->
            <div class="chon-ghe-section">
                <h3 class="chon-ghe-section-title">Tầng dưới</h3>
                <div class="row chon-ghe-hang">
                    @{
                        var gheTangDuoi = danhSachGhe.Skip(soGheTren).ToList();
                        int ghePerColDuoi = (int)Math.Ceiling(gheTangDuoi.Count / 3.0);
                    }
                    @for (int i = 0; i < 3; i++)
                    {
                        var gheCol = gheTangDuoi.Skip(i * ghePerColDuoi).Take(ghePerColDuoi);
                        <div class="col-md-4 chon-ghe-cot">
                            @foreach (var ghe in gheCol)
                            {
                                var isBooked = gheDaDat.Contains(ghe.IdVitri);
                                <button class="chon-ghe-seat @(isBooked ? "chon-ghe-occupied" : "chon-ghe-available")"
                                        @(isBooked ? "disabled" : "")
                                        data-id="@ghe.IdVitri"
                                        title="Ghế @ghe.Tenvitri @(isBooked ? "(Đã đặt)" : "(Còn trống)")">
                                    <i class="fas fa-chair chon-ghe-icon"></i>
                                    <span class="chon-ghe-number">@ghe.Tenvitri</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Cột bên phải: Thông tin chuyến đi -->
        <div class="col-md-4">
            <div class="chon-ghe-trip-info">
                <p style="color:#00ff34 !important">Thông tin lượt đi</p>
                <p><i class="fas fa-map-marker-alt"></i> Tuyến: @chuyenXe.TenChuyenXe</p>
                <p><i class="fas fa-bus"></i> Bến xuất phát: @(ViewBag.TuyenXe?.MaBenXeDiNavigation?.TenBenXe ?? "Chưa có thông tin")</p>
                <p><i class="fas fa-clock"></i> Thời gian xuất bến: @chuyenXe.ThoiDiemKhoiHanh?.ToString("HH:mm dd/MM/yyyy")</p>
                <p><i class="fas fa-car"></i> Loại xe: @(chuyenXe.BienSoXeNavigation?.IdLoaiNavigation?.Tenloai ?? "Không xác định") (@(chuyenXe.BienSoXeNavigation?.IdLoaiNavigation?.Soghe ?? 0) ghế)</p>
                <p><i class="fas fa-money-bill-wave"></i> Giá vé/1 ghế: @giaVe.ToString("N0") VND</p>
                <p>Biển số xe: @chuyenXe.BienSoXe</p>
                <div class="chon-ghe-total-price">
                    <p>Tổng tiền: <span id="totalPrice">0</span> VND</p>
                </div>

                <div class="chon-ghe-cancel-policy">
                    <h3 style="color:red">Chính sách hủy vé</h3>
                    <ul>
                        <li>Hủy trước 24h: hoàn 90% giá vé</li>
                        <li>Hủy trước 12h: hoàn 50% giá vé</li>
                        <li>Hủy sau 12h: không hoàn tiền</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <h2 style="color:#00ff34 !important">Điền thông tin cá nhân</h2>
    <div class="chon-ghe-form-container">
        <form method="post" asp-action="DatVe" onsubmit="return validateForm();">
            <input type="hidden" name="maChuyen" value="@ViewBag.MaChuyen" />
            <input type="hidden" id="selectedSeatsInput" name="selectedSeats" />
            <input type="hidden" id="totalPriceInput" name="totalPrice" />

            <div class="form-group">
                <label for="tenKhachHang">Tên khách hàng</label>
                <input type="text" id="tenKhachHang" name="tenKhachHang" class="form-control" placeholder="Nhập họ và tên" />
                <span class="text-danger" id="tenKhachHang-error"></span>
            </div>
            <div class="form-group">
                <label for="soDienThoai">Số điện thoại</label>
                <input type="text" id="soDienThoai" name="soDienThoai" class="form-control" placeholder="VD: 0912345678" />
                <span class="text-danger" id="soDienThoai-error"></span>
            </div>
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" class="form-control" placeholder="example@gmail.com" />
                <span class="text-danger" id="email-error"></span>
            </div>
            <div class="form-group">
                <label for="ghiChu">Ghi chú</label>
                <textarea id="ghiChu" name="ghiChu" class="form-control" placeholder="Nhập ghi chú nếu có"></textarea>
            </div>
            <div class="form-group">
                <label for="paymentMethod">Phương thức thanh toán</label>
                <select id="paymentMethod" name="paymentMethod" class="form-control" required>
                    <option value="">Chọn phương thức</option>
                    <option value="VNPay">VNPay</option>
                    <option value="MoMo">MoMo</option>
                </select>
                <span class="text-danger" id="paymentMethod-error"></span>
            </div>
            <button type="submit" class="btn btn-success mt-3">Đặt vé</button>
        </form>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    const seatButtons = document.querySelectorAll(".chon-ghe-available");
    const selectedSeats = new Set();
    const seatInput = document.getElementById("selectedSeatsInput");
    const totalPriceSpan = document.getElementById("totalPrice");
    const totalPriceInput = document.getElementById("totalPriceInput");
    const maxSeats = 5;
    const pricePerSeat = @giaVe;

    seatButtons.forEach(button => {
        button.addEventListener("click", function (e) {
            e.preventDefault();
            const seatId = this.dataset.id;

            if (selectedSeats.has(seatId)) {
                selectedSeats.delete(seatId);
                this.classList.remove("chon-ghe-selected");
            } else {
                if (selectedSeats.size >= maxSeats) {
                    alert(`Bạn chỉ có thể chọn tối đa ${maxSeats} ghế.`);
                    return;
                }
                selectedSeats.add(seatId);
                this.classList.add("chon-ghe-selected");
            }
            updateTotalPrice();
        });
    });

    function updateTotalPrice() {
        const totalPrice = selectedSeats.size * pricePerSeat;
        totalPriceSpan.innerText = totalPrice.toLocaleString();
        totalPriceInput.value = totalPrice;
        seatInput.value = Array.from(selectedSeats).join(",");
    }
</script>
