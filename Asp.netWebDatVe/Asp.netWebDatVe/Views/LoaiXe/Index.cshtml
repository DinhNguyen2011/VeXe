@model IEnumerable<Asp.netWebDatVe.Models.Loaixe>

@{
    ViewData["Title"] = "Danh sách loại xe";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Bootstrap Icons (nếu chưa có trong layout) -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container mt-4">
    <h2 class="text-center mb-4">Danh sách loại xe</h2>

    <div class="mb-3 text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Thêm loại xe mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-striped text-center align-middle">
            <thead class="table-light">
                <tr>
                    <th>Mã loại</th>
                    <th>Tên loại xe</th>
                    <th>Số ghế</th>
                    <th>Tác vụ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdLoai</td>
                        <td>@item.Tenloai</td>
                        <td>@item.Soghe</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.IdLoai" class="btn btn-outline-primary btn-sm me-1" title="Sửa">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.IdLoai" class="btn btn-outline-danger btn-sm" title="Xóa" onclick="return confirm('Bạn có chắc muốn xóa loại xe này không?');">
                                <i class="bi bi-trash-fill"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
