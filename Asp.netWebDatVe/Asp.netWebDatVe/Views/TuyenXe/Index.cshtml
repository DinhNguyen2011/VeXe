@model IEnumerable<Asp.netWebDatVe.Models.TuyenXe>

@{
    ViewData["Title"] = "Danh sách tuyến xe";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<style>
    .tuyenxe-container {
        padding: 2rem;
        background-color: #f8f9fa;
        border-radius: 0.75rem;
    }

    .tuyenxe-title {
        font-weight: 600;
        margin-bottom: 1.5rem;
    }

    .tuyenxe-table th,
    .tuyenxe-table td {
        vertical-align: middle;
        word-break: break-word;
    }

    .tuyenxe-btn-action {
        margin-right: 5px;
    }

    .alert-dismissible .btn-close {
        position: absolute;
        top: 0.75rem;
        right: 1rem;
    }
</style>

<div class="tuyenxe-container">

    <h2 class="tuyenxe-title">🚌 Danh sách tuyến xe</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show tuyenxe-alert" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show tuyenxe-alert" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i> Thêm tuyến xe
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle text-center tuyenxe-table">
            <thead class="table-light">
                <tr>
                    <th>Mã tuyến</th>
                    <th>Điểm đi</th>
                    <th>Điểm đến</th>
                    <th>Bến xe đi</th>
                    <th>Bến xe đến</th>
                    <th>Số ngày chạy/tuần</th>
                    <th>Giá hiện hành</th>
                    <th>Quãng đường</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MaTuyen</td>
                        <td>@item.DiemDi</td>
                        <td>@item.DiemDen</td>
                        <td>@item.MaBenXeDiNavigation?.TenBenXe</td>
                        <td>@item.MaBenXeDenNavigation?.TenBenXe</td>
                        <td>@item.SoNgayChayTrongTuan</td>
                        <td>@item.GiaHienHanh?.ToString("N0") VNĐ</td>
                        <td>@item.QuangDuong km</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.MaTuyen" class="btn btn-outline-warning btn-sm tuyenxe-btn-action" title="Sửa">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.MaTuyen" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tuyến xe này không?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm tuyenxe-btn-action" title="Xóa">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
