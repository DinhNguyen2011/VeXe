@model IEnumerable<Asp.netWebDatVe.Models.TuyenXe>

@{
    ViewData["Title"] = "Danh sách tuyến xe";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<style>
    .tuyenxe-table {
        width: 100%;
        table-layout: auto;
    }

        .tuyenxe-table th,
        .tuyenxe-table td {
            white-space: normal;
            word-break: break-word;
            padding: 6px 8px;
            font-size: 14px;
        }

</style>
<div class="tuyenxe-container">
    <h2 class="tuyenxe-title">Danh sách tuyến xe</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success tuyenxe-alert">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger tuyenxe-alert">@TempData["Error"]</div>
    }

    <p>
        <a asp-action="Create" class="btn btn-primary tuyenxe-btn">Thêm tuyến xe</a>
    </p>
    <div class="table-responsive-wrapper">
    <table class="table table-striped tuyenxe-table">
        <thead>
            <tr>
                <th>Mã tuyến</th>
                <th>Điểm đi</th>
                <th>Điểm đến</th>
                <th>Bến xe đi</th>
                <th>Bến xe đến</th>
                <th>Số ngày chạy/tuần</th>
                <th>Giá hiện hành</th>
                <th>Quãng đường</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaTuyen</td>
                    <td>@item.DiemDi</td>
                    <td>@item.DiemDen</td>
                    <td>@item.MaBenXeDiNavigation.TenBenXe</td>
                    <td>@item.MaBenXeDenNavigation.TenBenXe</td>
                    <td>@item.SoNgayChayTrongTuan</td>
                    <td>@item.GiaHienHanh?.ToString("N0") VNĐ</td>
                    <td>@item.QuangDuong km</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.MaTuyen" class="btn btn-warning btn-sm tuyenxe-btn-action">Sửa</a>
                        <form asp-action="Delete" asp-route-id="@item.MaTuyen" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tuyến xe này không?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm tuyenxe-btn-action">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>