@model Asp.netWebDatVe.Models.TuyenXe

@{
    ViewData["Title"] = "Sửa tuyến xe";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<link rel="stylesheet" href="~/css/TuyenXe.css" />

<div class="tuyenxe-container">
    <h2 class="tuyenxe-title">Sửa tuyến xe</h2>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MaTuyen" />

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="DiemDi"></label>
            <input asp-for="DiemDi" class="form-control" />
            <span asp-validation-for="DiemDi" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="DiemDen"></label>
            <input asp-for="DiemDen" class="form-control" />
            <span asp-validation-for="DiemDen" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MaBenXeDi"></label>
            <select asp-for="MaBenXeDi" class="form-control" asp-items="ViewBag.MaBenXeDi"></select>
            <span asp-validation-for="MaBenXeDi" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MaBenXeDen"></label>
            <select asp-for="MaBenXeDen" class="form-control" asp-items="ViewBag.MaBenXeDen"></select>
            <span asp-validation-for="MaBenXeDen" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="SoNgayChayTrongTuan"></label>
            <input asp-for="SoNgayChayTrongTuan" class="form-control" type="number" />
            <span asp-validation-for="SoNgayChayTrongTuan" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="GiaHienHanh"></label>
            <input asp-for="GiaHienHanh" class="form-control" type="number" step="1000" />
            <span asp-validation-for="GiaHienHanh" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="QuangDuong"></label>
            <input asp-for="QuangDuong" class="form-control" type="number" />
            <span asp-validation-for="QuangDuong" class="text-danger"></span>
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary">Lưu</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </form>
</div>
