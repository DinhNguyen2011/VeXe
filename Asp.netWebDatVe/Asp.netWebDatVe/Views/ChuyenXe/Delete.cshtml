@model Asp.netWebDatVe.Models.ChuyenXe

@{
    ViewData["Title"] = "Xóa Chuyến Xe";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<link rel="stylesheet" href="~/css/PhieuDatVe.css" />

<div class="phieudatve-container">
    <h2 class="phieudatve-title">Xóa chuyến xe</h2>

    <div class="alert alert-warning phieudatve-alert">
        Bạn có chắc chắn muốn xóa chuyến xe <strong>@Model.MaChuyen</strong> không? Hành động này không thể hoàn tác.
    </div>

    <dl class="row phieudatve-details">
        <dt class="col-sm-3 phieudatve-label">Mã chuyến</dt>
        <dd class="col-sm-9">@Model.MaChuyen</dd>

        <dt class="col-sm-3 phieudatve-label">Tên chuyến xe</dt>
        <dd class="col-sm-9">@Model.TenChuyenXe</dd>

        <dt class="col-sm-3 phieudatve-label">Tuyến xe</dt>
        <dd class="col-sm-9">@Model.MaTuyenNavigation?.DiemDi - @Model.MaTuyenNavigation?.DiemDen</dd>

        <dt class="col-sm-3 phieudatve-label">Biển số xe</dt>
        <dd class="col-sm-9">@Model.BienSoXe</dd>

        <dt class="col-sm-3 phieudatve-label">Thời điểm khởi hành</dt>
        <dd class="col-sm-9">@Model.ThoiDiemKhoiHanh?.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-3 phieudatve-label">Thời điểm đến dự kiến</dt>
        <dd class="col-sm-9">@Model.ThoiDiemDenDuKien?.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-3 phieudatve-label">Giá vé</dt>
        <dd class="col-sm-9">@Model.GiaVe?.ToString("N0") VNĐ</dd>

        <dt class="col-sm-3 phieudatve-label">Ghi chú</dt>
        <dd class="col-sm-9">@Model.GhiChu</dd>

        <dt class="col-sm-3 phieudatve-label">Tài xế</dt>
        <dd class="col-sm-9">@(Model.MaTaiXeNavigation?.HoTen ?? "Không có")</dd>

        <dt class="col-sm-3 phieudatve-label">Nhân viên hỗ trợ</dt>
        <dd class="col-sm-9">@(Model.MaNhanVienNavigation?.HoTen ?? "Không có")</dd>

        <dt class="col-sm-3 phieudatve-label">Nhân viên phụ xe</dt>
        <dd class="col-sm-9">@(Model.MaNhanVien1Navigation?.HoTen ?? "Không có")</dd>

        <dt class="col-sm-3 phieudatve-label">Số vé xe</dt>
        <dd class="col-sm-9">@(ViewBag.CanDelete ? "0" : "Có vé liên quan")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MaChuyen" />
        <div class="form-group phieudatve-form-group">
            <button type="submit" class="btn btn-danger phieudatve-btn" @(ViewBag.CanDelete ? "" : "disabled")>Xóa</button>
            <a asp-action="Index" class="btn btn-secondary phieudatve-btn">Hủy</a>
        </div>
    </form>
</div>